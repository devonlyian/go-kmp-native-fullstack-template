{
  "description": "Check reviewed documentation when a turn finishes; no builds or automatic review recording.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/codex-stop.py\"",
            "timeout": 20,
            "statusMessage": "Checking documentation pairs"
          }
        ]
      }
    ]
  }
}
